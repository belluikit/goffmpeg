# Intermediate FFmpeg build tree — regenerated by `make`; only dist/ is vendored.
internal/libav/build/

# Build output. The static libraries are published as per-platform companion
# modules under github.com/trendvidia/goffmpeg-libs, so nothing here is
# committed — only the shared headers in internal/libav/include are, since the
# FFmpeg public headers are identical across every target.
#
#   make dist TARGET=linux_amd64      # build into internal/libav/dist
#   make sync-libs TARGET=linux_amd64 # copy into ../goffmpeg-libs
internal/libav/dist/

# Compiled binaries and test artifacts
*.test
*.out
*.prof
coverage.txt
coverage.html

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp
