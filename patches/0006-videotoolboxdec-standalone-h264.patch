+/**
+ * @file
+ * A standalone H.264 decoder on Apple's VideoToolbox.
+ *
+ * The h264_videotoolbox hwaccel decodes through FFmpeg's own h264 decoder,
+ * which parses every slice and hands VideoToolbox one picture at a time. This
+ * decoder needs no software H.264 decoder: like h264_mediacodec, it takes the
+ * demuxer's packets whole, MP4's length-prefixed NAL units or MPEG-TS's
+ * Annex B, gives VideoToolbox the access unit, and puts the pictures it
+ * returns, in decoding order, into presentation order by their timestamps.
+ * Frames come out as NV12 in system memory.
+ */
+
+#include <VideoToolbox/VideoToolbox.h>
+
+#include "libavutil/imgutils.h"
+#include "libavutil/intreadwrite.h"
+#include "libavutil/mem.h"
+#include "libavutil/opt.h"
+
+#include "avcodec.h"
+#include "codec_internal.h"
+#include "decode.h"
+#include "h2645_parse.h"
+#include "h264.h"
+#include "h264_parse.h"
+#include "golomb.h"
+#include "h264_ps.h"
+
+/* Enough for H.264's largest DPB (16 frames) and the one being output. */
+#define VTDEC_MAX_QUEUE 17
+
+typedef struct VTDecContext {
+    const AVClass *class;
+
+    VTDecompressionSessionRef session;
+    CMVideoFormatDescriptionRef format;
+
+    H264ParamSets ps;
+    H2645Packet nals;
+    int is_avc;
+    int nal_length_size;
+
+    /* The parameter sets as they arrived, escaped, with their NAL header:
+     * what CMVideoFormatDescriptionCreateFromH264ParameterSets takes. */
+    uint8_t *sps, *pps;
+    int sps_size, pps_size;
+    unsigned sps_id;
+    int ps_changed;
+
+    AVPacket *pkt;
+    /* Decoded pictures waiting for their turn, in presentation order: by
+     * generation, which an IDR starts, then by timestamp. An IDR resets
+     * H.264's picture order, so every picture before it is shown before any
+     * after it, whatever their timestamps say: they jump back at an HLS
+     * discontinuity, and where two streams were joined. */
+    AVFrame *queue[VTDEC_MAX_QUEUE];
+    int64_t queue_gen[VTDEC_MAX_QUEUE];
+    int nb_queued;
+    int64_t gen;
+    int reorder;
+    int eof;
+
+    /* What the session decodes: the cropped picture size and the SPS it was
+     * made from, for the frames it returns. */
+    int width, height;
+    int full_range;
+    const SPS *active;
+
+    /* The decode callback's frame, or its error, for the packet being
+     * decoded: VideoToolbox decodes synchronously here, so the callback runs
+     * inside VTDecompressionSessionDecodeFrame on this thread. */
+    int cb_error;
+    OSStatus cb_status;
+    int decode_errors;
+} VTDecContext;
+
+static void vtdec_drop_queue(VTDecContext *s)
+{
+    for (int i = 0; i < s->nb_queued; i++)
+        av_frame_free(&s->queue[i]);
+    s->nb_queued = 0;
+}
+
+static void vtdec_destroy_session(VTDecContext *s)
+{
+    if (s->session) {
+        VTDecompressionSessionWaitForAsynchronousFrames(s->session);
+        VTDecompressionSessionInvalidate(s->session);
+        CFRelease(s->session);
+        s->session = NULL;
+    }
+    if (s->format) {
+        CFRelease(s->format);
+        s->format = NULL;
+    }
+}
+
+/* Insert f, of the current generation, in presentation order. */
+static int vtdec_queue_frame(VTDecContext *s, AVFrame *f)
+{
+    int i;
+    if (s->nb_queued >= VTDEC_MAX_QUEUE)
+        return AVERROR_BUG;
+    for (i = s->nb_queued; i > 0; i--) {
+        if (s->queue_gen[i - 1] < s->gen ||
+            s->queue[i - 1]->pts == AV_NOPTS_VALUE || f->pts == AV_NOPTS_VALUE ||
+            s->queue[i - 1]->pts <= f->pts)
+            break;
+        s->queue[i]     = s->queue[i - 1];
+        s->queue_gen[i] = s->queue_gen[i - 1];
+    }
+    s->queue[i]     = f;
+    s->queue_gen[i] = s->gen;
+    s->nb_queued++;
+    return 0;
+}
+
+static void vtdec_output(void *opaque, void *source_ref, OSStatus status,
+                         VTDecodeInfoFlags flags, CVImageBufferRef image,
+                         CMTime pts, CMTime duration)
+{
+    AVCodecContext *avctx = opaque;
+    VTDecContext *s = avctx->priv_data;
+    AVFrame *f;
+    int ret;
+
+    if (status) {
+        av_log(avctx, AV_LOG_DEBUG, "VideoToolbox decode error %d\n", (int)status);
+        s->cb_status = status;
+        s->cb_error  = AVERROR_EXTERNAL;
+        return;
+    }
+    if (!image) /* a dropped frame */
+        return;
+    if (CVPixelBufferGetPlaneCount(image) != 2 ||
+        (int)CVPixelBufferGetWidth(image) < s->width ||
+        (int)CVPixelBufferGetHeight(image) < s->height) {
+        av_log(avctx, AV_LOG_ERROR, "VideoToolbox returned a %dx%d picture with %d planes, want NV12 %dx%d\n",
+               (int)CVPixelBufferGetWidth(image), (int)CVPixelBufferGetHeight(image),
+               (int)CVPixelBufferGetPlaneCount(image), s->width, s->height);
+        s->cb_error = AVERROR_EXTERNAL;
+        return;
+    }
+
+    if (!(f = av_frame_alloc())) {
+        s->cb_error = AVERROR(ENOMEM);
+        return;
+    }
+    f->format = AV_PIX_FMT_NV12;
+    f->width  = s->width;
+    f->height = s->height;
+    if ((ret = ff_get_buffer(avctx, f, 0)) < 0) {
+        av_frame_free(&f);
+        s->cb_error = ret;
+        return;
+    }
+    CVPixelBufferLockBaseAddress(image, kCVPixelBufferLock_ReadOnly);
+    av_image_copy_plane(f->data[0], f->linesize[0],
+                        CVPixelBufferGetBaseAddressOfPlane(image, 0),
+                        CVPixelBufferGetBytesPerRowOfPlane(image, 0),
+                        s->width, s->height);
+    av_image_copy_plane(f->data[1], f->linesize[1],
+                        CVPixelBufferGetBaseAddressOfPlane(image, 1),
+                        CVPixelBufferGetBytesPerRowOfPlane(image, 1),
+                        (s->width + 1) & ~1, (s->height + 1) >> 1);
+    CVPixelBufferUnlockBaseAddress(image, kCVPixelBufferLock_ReadOnly);
+
+    f->pts = CMTIME_IS_VALID(pts) ? pts.value : AV_NOPTS_VALUE;
+    f->duration = CMTIME_IS_VALID(duration) ? duration.value : 0;
+    f->color_range = avctx->color_range;
+    f->color_primaries     = avctx->color_primaries;
+    f->color_trc           = avctx->color_trc;
+    f->colorspace          = avctx->colorspace;
+    f->chroma_location     = avctx->chroma_sample_location;
+    f->sample_aspect_ratio = avctx->sample_aspect_ratio;
+
+    if ((ret = vtdec_queue_frame(s, f)) < 0) {
+        av_frame_free(&f);
+        s->cb_error = ret;
+    }
+}
+
+static int vtdec_set_ps(uint8_t **dst, int *dst_size, const uint8_t *src, int size, int *changed)
+{
+    if (*dst && *dst_size == size && !memcmp(*dst, src, size))
+        return 0;
+    av_freep(dst);
+    if (!(*dst = av_malloc(size)))
+        return AVERROR(ENOMEM);
+    memcpy(*dst, src, size);
+    *dst_size = size;
+    *changed = 1;
+    return 0;
+}
+
+/* A parameter set NAL unit: parse it, and keep its bytes for the session. */
+static int vtdec_parameter_set(AVCodecContext *avctx, H2645NAL *nal)
+{
+    VTDecContext *s = avctx->priv_data;
+    int ret;
+
+    if (nal->type == H264_NAL_SPS) {
+        GetBitContext gb = nal->gb;
+        unsigned id;
+        ret = ff_h264_decode_seq_parameter_set(&gb, avctx, &s->ps, 1);
+        if (ret < 0)
+            return ret;
+        /* seq_parameter_set_id follows profile_idc, the constraint flags
+         * and level_idc */
+        gb = nal->gb;
+        skip_bits(&gb, 24);
+        id = get_ue_golomb_31(&gb);
+        if (id >= MAX_SPS_COUNT || !s->ps.sps_list[id])
+            return AVERROR_INVALIDDATA;
+        if (id != s->sps_id)
+            s->ps_changed = 1;
+        s->sps_id = id;
+        return vtdec_set_ps(&s->sps, &s->sps_size, nal->raw_data, nal->raw_size, &s->ps_changed);
+    }
+    if (nal->type == H264_NAL_PPS) {
+        GetBitContext gb = nal->gb;
+        ret = ff_h264_decode_picture_parameter_set(&gb, avctx, &s->ps, nal->size_bits);
+        if (ret < 0)
+            return ret;
+        return vtdec_set_ps(&s->pps, &s->pps_size, nal->raw_data, nal->raw_size, &s->ps_changed);
+    }
+    return 0;
+}
+
+static CFDictionaryRef vtdec_buffer_attributes(int full_range)
+{
+    OSType pix = full_range ? kCVPixelFormatType_420YpCbCr8BiPlanarFullRange
+                            : kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange;
+    CFNumberRef num = CFNumberCreate(kCFAllocatorDefault, kCFNumberSInt32Type, &pix);
+    CFDictionaryRef io = CFDictionaryCreate(kCFAllocatorDefault, NULL, NULL, 0,
+                                            &kCFTypeDictionaryKeyCallBacks,
+                                            &kCFTypeDictionaryValueCallBacks);
+    const void *keys[] = { kCVPixelBufferPixelFormatTypeKey, kCVPixelBufferIOSurfacePropertiesKey };
+    const void *vals[] = { num, io };
+    CFDictionaryRef attrs = CFDictionaryCreate(kCFAllocatorDefault, keys, vals, 2,
+                                               &kCFTypeDictionaryKeyCallBacks,
+                                               &kCFTypeDictionaryValueCallBacks);
+    CFRelease(num);
+    CFRelease(io);
+    return attrs;
+}
+
+/* Make the session from the stored parameter sets. The SPS decides what it
+ * decodes; VideoToolbox here is given 8-bit 4:2:0 only, which is what it
+ * outputs as NV12. */
+static int vtdec_create_session(AVCodecContext *avctx)
+{
+    VTDecContext *s = avctx->priv_data;
+    const SPS *sps = NULL;
+    const uint8_t *sets[2];
+    size_t sizes[2];
+    CFDictionaryRef attrs;
+    VTDecompressionOutputCallbackRecord cb = { vtdec_output, avctx };
+    OSStatus status;
+
+    vtdec_destroy_session(s);
+    s->ps_changed = 0;
+    if (!s->sps || !s->pps)
+        return AVERROR_INVALIDDATA;
+
+    sps = s->ps.sps_list[s->sps_id];
+    if (!sps)
+        return AVERROR_INVALIDDATA;
+    if (sps->chroma_format_idc != 1 || sps->bit_depth_luma != 8 || sps->bit_depth_chroma != 8) {
+        av_log(avctx, AV_LOG_ERROR, "VideoToolbox decodes 8-bit 4:2:0 here, not chroma format %d at %d bits\n",
+               sps->chroma_format_idc, sps->bit_depth_luma);
+        return AVERROR(ENOSYS);
+    }
+
+    sets[0]  = s->sps; sizes[0] = s->sps_size;
+    sets[1]  = s->pps; sizes[1] = s->pps_size;
+    status = CMVideoFormatDescriptionCreateFromH264ParameterSets(kCFAllocatorDefault, 2, sets, sizes,
+                                                                 4, &s->format);
+    if (status) {
+        av_log(avctx, AV_LOG_ERROR, "VideoToolbox format description from the SPS and PPS failed: %d\n", (int)status);
+        return AVERROR_INVALIDDATA;
+    }
+
+    s->full_range = sps->vui.video_full_range_flag > 0;
+    attrs = vtdec_buffer_attributes(s->full_range);
+    status = VTDecompressionSessionCreate(kCFAllocatorDefault, s->format, NULL, attrs, &cb, &s->session);
+    CFRelease(attrs);
+    if (status) {
+        av_log(avctx, AV_LOG_ERROR, "VideoToolbox session creation failed: %d\n", (int)status);
+        CFRelease(s->format);
+        s->format = NULL;
+        s->session = NULL;
+        return status == kVTCouldNotFindVideoDecoderErr || status == kVTVideoDecoderUnsupportedDataFormatErr ||
+               status == kVTVideoDecoderNotAvailableNowErr ? AVERROR(ENOSYS) : AVERROR_EXTERNAL;
+    }
+
+    s->active  = sps;
+    s->width   = 16 * sps->mb_width  - sps->crop_left - sps->crop_right;
+    s->height  = 16 * sps->mb_height - sps->crop_top  - sps->crop_bottom;
+    s->reorder = FFMIN(sps->num_reorder_frames, VTDEC_MAX_QUEUE - 1);
+    if (!sps->bitstream_restriction_flag && !sps->ref_frame_count)
+        s->reorder = 0;
+
+    avctx->pix_fmt      = AV_PIX_FMT_NV12;
+    avctx->width        = avctx->coded_width  = s->width;
+    avctx->height       = avctx->coded_height = s->height;
+    avctx->has_b_frames = s->reorder;
+    avctx->profile      = ff_h264_get_profile(sps);
+    avctx->level        = sps->level_idc;
+    /* As h264's h264_init_ps sets them: the range and colours only where the
+     * VUI signals them, the chroma siting and aspect ratio as parsed. */
+    avctx->color_range = !sps->vui.video_signal_type_present_flag ? AVCOL_RANGE_UNSPECIFIED :
+                         s->full_range ? AVCOL_RANGE_JPEG : AVCOL_RANGE_MPEG;
+    if (sps->vui.video_signal_type_present_flag && sps->vui.colour_description_present_flag) {
+        avctx->color_primaries = sps->vui.colour_primaries;
+        avctx->color_trc       = sps->vui.transfer_characteristics;
+        avctx->colorspace      = sps->vui.matrix_coeffs;
+    } else {
+        avctx->color_primaries = AVCOL_PRI_UNSPECIFIED;
+        avctx->color_trc       = AVCOL_TRC_UNSPECIFIED;
+        avctx->colorspace      = AVCOL_SPC_UNSPECIFIED;
+    }
+    avctx->chroma_sample_location = sps->vui.chroma_location;
+    ff_set_sar(avctx, sps->vui.sar);
+    return 0;
+}
+
+/* Take the parameter sets out of an access unit, and write the rest as
+ * 4-byte length-prefixed NAL units, which is what the session's format
+ * description says. */
+static int vtdec_split(AVCodecContext *avctx, const uint8_t *data, int size,
+                       uint8_t **out, int *out_size, int *slices)
+{
+    VTDecContext *s = avctx->priv_data;
+    int ret, total = 0;
+    uint8_t *p;
+
+    *slices = 0;
+    ret = ff_h2645_packet_split(&s->nals, data, size, avctx,
+                                s->is_avc ? s->nal_length_size : 0, AV_CODEC_ID_H264,
+                                s->is_avc ? H2645_FLAG_IS_NALFF : 0);
+    if (ret < 0)
+        return ret;
+    for (int i = 0; i < s->nals.nb_nals; i++) {
+        H2645NAL *nal = &s->nals.nals[i];
+        if (nal->type == H264_NAL_SPS || nal->type == H264_NAL_PPS) {
+            if ((ret = vtdec_parameter_set(avctx, nal)) < 0)
+                av_log(avctx, AV_LOG_WARNING, "Ignoring a parameter set that does not parse\n");
+            continue;
+        }
+        if (nal->type == H264_NAL_SLICE || nal->type == H264_NAL_IDR_SLICE)
+            (*slices)++;
+        if (nal->type == H264_NAL_IDR_SLICE && *slices == 1)
+            s->gen++;
+        total += 4 + nal->raw_size;
+    }
+    if (!*slices)
+        return 0;
+    if (!(p = *out = av_malloc(total)))
+        return AVERROR(ENOMEM);
+    for (int i = 0; i < s->nals.nb_nals; i++) {
+        H2645NAL *nal = &s->nals.nals[i];
+        if (nal->type == H264_NAL_SPS || nal->type == H264_NAL_PPS)
+            continue;
+        AV_WB32(p, nal->raw_size);
+        memcpy(p + 4, nal->raw_data, nal->raw_size);
+        p += 4 + nal->raw_size;
+    }
+    *out_size = total;
+    return 0;
+}
+
+static int vtdec_decode_au(AVCodecContext *avctx, uint8_t *au, int size, const AVPacket *pkt)
+{
+    VTDecContext *s = avctx->priv_data;
+    CMBlockBufferRef block = NULL;
+    CMSampleBufferRef sample = NULL;
+    CMSampleTimingInfo timing = {
+        .duration              = pkt->duration ? CMTimeMake(pkt->duration, 1) : kCMTimeInvalid,
+        .presentationTimeStamp = pkt->pts != AV_NOPTS_VALUE ? CMTimeMake(pkt->pts, 1) :
+                                 pkt->dts != AV_NOPTS_VALUE ? CMTimeMake(pkt->dts, 1) : kCMTimeInvalid,
+        .decodeTimeStamp       = kCMTimeInvalid,
+    };
+    size_t sample_size = size;
+    VTDecodeInfoFlags info = 0;
+    OSStatus status;
+    int retried = 0;
+
+    status = CMBlockBufferCreateWithMemoryBlock(kCFAllocatorDefault, NULL, size, kCFAllocatorDefault,
+                                                NULL, 0, size, kCMBlockBufferAssureMemoryNowFlag, &block);
+    if (!status)
+        status = CMBlockBufferReplaceDataBytes(au, block, 0, size);
+    if (!status)
+        status = CMSampleBufferCreateReady(kCFAllocatorDefault, block, s->format, 1, 1, &timing,
+                                           1, &sample_size, &sample);
+    if (block)
+        CFRelease(block);
+    if (status) {
+        av_log(avctx, AV_LOG_ERROR, "VideoToolbox sample buffer: %d\n", (int)status);
+        return AVERROR_EXTERNAL;
+    }
+
+again:
+    s->cb_error = 0;
+    status = VTDecompressionSessionDecodeFrame(s->session, sample, 0, NULL, &info);
+    if (status == kVTInvalidSessionErr && !retried) {
+        /* iOS invalidates sessions, as when the app goes to the background.
+         * Pictures that reference ones before this point come out damaged or
+         * not at all until the next IDR. */
+        int ret;
+        av_log(avctx, AV_LOG_WARNING, "VideoToolbox session invalidated; making a new one\n");
+        retried = 1;
+        if ((ret = vtdec_create_session(avctx)) < 0) {
+            CFRelease(sample);
+            return ret;
+        }
+        goto again;
+    }
+    CFRelease(sample);
+    if (status) {
+        av_log(avctx, AV_LOG_DEBUG, "VideoToolbox decode failed: %d\n", (int)status);
+        s->cb_status = status;
+        return AVERROR_EXTERNAL;
+    }
+    return s->cb_error;
+}
+
+static int vtdec_decode_packet(AVCodecContext *avctx, const AVPacket *pkt)
+{
+    VTDecContext *s = avctx->priv_data;
+    uint8_t *au = NULL;
+    int au_size = 0, slices, ret;
+
+    if ((ret = vtdec_split(avctx, pkt->data, pkt->size, &au, &au_size, &slices)) < 0)
+        return ret;
+    if (!slices)
+        return 0;
+    if (!s->session || s->ps_changed) {
+        /* A new SPS can change the size: the queued frames keep theirs. */
+        if ((ret = vtdec_create_session(avctx)) < 0) {
+            av_free(au);
+            return ret;
+        }
+    }
+    ret = vtdec_decode_au(avctx, au, au_size, pkt);
+    av_free(au);
+    /* A picture VideoToolbox can't decode is dropped, and decoding goes on
+     * from the next one, as FFmpeg's h264 conceals damage and goes on. A
+     * stream it decodes nothing of comes out as no frames at all, which the
+     * caller can tell. */
+    if (ret == AVERROR_EXTERNAL) {
+        if (!s->decode_errors++)
+            av_log(avctx, AV_LOG_WARNING, "VideoToolbox could not decode a picture (%d); dropping it and any like it\n",
+                   (int)s->cb_status);
+        return 0;
+    }
+    return ret;
+}
+
+static int vtdec_receive_frame(AVCodecContext *avctx, AVFrame *frame)
+{
+    VTDecContext *s = avctx->priv_data;
+    int ret;
+
+    for (;;) {
+        /* A picture of an earlier generation goes at once: nothing decoded
+         * after the IDR that ended it is shown before it. */
+        if (s->nb_queued > s->reorder || (s->eof && s->nb_queued) ||
+            (s->nb_queued && s->queue_gen[0] < s->gen)) {
+            av_frame_move_ref(frame, s->queue[0]);
+            av_frame_free(&s->queue[0]);
+            s->nb_queued--;
+            memmove(s->queue, s->queue + 1, s->nb_queued * sizeof(*s->queue));
+            memmove(s->queue_gen, s->queue_gen + 1, s->nb_queued * sizeof(*s->queue_gen));
+            return 0;
+        }
+        if (s->eof)
+            return AVERROR_EOF;
+
+        ret = ff_decode_get_packet(avctx, s->pkt);
+        if (ret == AVERROR_EOF) {
+            s->eof = 1;
+            if (s->session)
+                VTDecompressionSessionWaitForAsynchronousFrames(s->session);
+            continue;
+        }
+        if (ret < 0)
+            return ret;
+        ret = vtdec_decode_packet(avctx, s->pkt);
+        av_packet_unref(s->pkt);
+        if (ret < 0)
+            return ret;
+    }
+}
+
+static av_cold int vtdec_init(AVCodecContext *avctx)
+{
+    VTDecContext *s = avctx->priv_data;
+    int ret;
+
+    if (!(s->pkt = av_packet_alloc()))
+        return AVERROR(ENOMEM);
+    s->nal_length_size = 4;
+
+    if (avctx->extradata_size > 0 && avctx->extradata) {
+        const uint8_t *p = avctx->extradata;
+        int size = avctx->extradata_size;
+        if (p[0] == 1) {
+            /* avcC: its parameter sets, and the length size of the NAL units
+             * that follow. The first SPS and PPS make the session. */
+            int cnt, n;
+            if (size < 7)
+                return AVERROR_INVALIDDATA;
+            s->is_avc = 1;
+            s->nal_length_size = (p[4] & 3) + 1;
+            p += 5;
+            for (int set = 0; set < 2; set++) {
+                cnt = set ? *p++ : (*p++ & 0x1f);
+                for (int i = 0; i < cnt; i++) {
+                    if (p + 2 > avctx->extradata + size)
+                        return AVERROR_INVALIDDATA;
+                    n = AV_RB16(p);
+                    p += 2;
+                    if (p + n > avctx->extradata + size)
+                        return AVERROR_INVALIDDATA;
+                    /* p is a bare NAL unit: split it as one with a 2-byte length */
+                    {
+                        uint8_t *tmp = av_malloc(n + 2 + AV_INPUT_BUFFER_PADDING_SIZE);
+                        if (!tmp)
+                            return AVERROR(ENOMEM);
+                        AV_WB16(tmp, n);
+                        memcpy(tmp + 2, p, n);
+                        memset(tmp + 2 + n, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+                        ret = ff_h2645_packet_split(&s->nals, tmp, n + 2, avctx, 2, AV_CODEC_ID_H264,
+                                                    H2645_FLAG_IS_NALFF);
+                        if (ret >= 0 && s->nals.nb_nals == 1)
+                            ret = vtdec_parameter_set(avctx, &s->nals.nals[0]);
+                        av_free(tmp);
+                    }
+                    if (ret < 0)
+                        return ret;
+                    p += n;
+                }
+            }
+        } else {
+            uint8_t *au = NULL;
+            int au_size, slices;
+            if ((ret = vtdec_split(avctx, p, size, &au, &au_size, &slices)) < 0)
+                return ret;
+            av_free(au);
+        }
+        if (s->sps && s->pps && (ret = vtdec_create_session(avctx)) < 0)
+            return ret;
+    }
+    return 0;
+}
+
+static void vtdec_flush(AVCodecContext *avctx)
+{
+    VTDecContext *s = avctx->priv_data;
+    if (s->session)
+        VTDecompressionSessionWaitForAsynchronousFrames(s->session);
+    vtdec_drop_queue(s);
+    s->eof = 0;
+}
+
+static av_cold int vtdec_close(AVCodecContext *avctx)
+{
+    VTDecContext *s = avctx->priv_data;
+    vtdec_destroy_session(s);
+    vtdec_drop_queue(s);
+    ff_h264_ps_uninit(&s->ps);
+    ff_h2645_packet_uninit(&s->nals);
+    av_packet_free(&s->pkt);
+    av_freep(&s->sps);
+    av_freep(&s->pps);
+    return 0;
+}
+
+static const AVClass vtdec_class = {
+    .class_name = "h264_videotoolbox",
+    .item_name  = av_default_item_name,
+    .version    = LIBAVUTIL_VERSION_INT,
+};
+
+const FFCodec ff_h264_videotoolbox_decoder = {
+    .p.name         = "h264_videotoolbox",
+    CODEC_LONG_NAME("H.264 (VideoToolbox)"),
+    .p.type         = AVMEDIA_TYPE_VIDEO,
+    .p.id           = AV_CODEC_ID_H264,
+    .p.priv_class   = &vtdec_class,
+    .priv_data_size = sizeof(VTDecContext),
+    .init           = vtdec_init,
+    FF_CODEC_RECEIVE_FRAME_CB(vtdec_receive_frame),
+    .flush          = vtdec_flush,
+    .close          = vtdec_close,
+    .p.capabilities = AV_CODEC_CAP_DELAY | AV_CODEC_CAP_HARDWARE,
+    .caps_internal  = FF_CODEC_CAP_INIT_CLEANUP | FF_CODEC_CAP_NOT_INIT_THREADSAFE,
+    .p.wrapper_name = "videotoolbox",
+};
