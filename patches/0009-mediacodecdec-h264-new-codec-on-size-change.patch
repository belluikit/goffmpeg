+                AVPacket null_pkt = { 0 };
+                av_packet_move_ref(&s->reconfig_pkt, &s->buffered_pkt);
+                s->reconfig = 1;
+                ret = ff_mediacodec_dec_send(avctx, s->ctx, &null_pkt, true);
+                if (ret < 0)
+                    return ret;
+                return mediacodec_receive_frame(avctx, frame);
+            }
+        }
+#endif
         if (ret >= 0 && avctx->codec_type == AVMEDIA_TYPE_AUDIO)
             ff_mediacodec_dec_note_skip(avctx, s->ctx, &s->buffered_pkt);
         if (ret >= 0 && avctx->codec_id == AV_CODEC_ID_AAC && !avctx->extradata_size && !s->aac_config) {
